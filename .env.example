# ============================================================
# 知源 KnowledgeCool · 环境变量样例
# 复制为 .env 后按实际环境填写。**不要把真实密钥提交进仓库。**
# ============================================================

# ---------------- 运行环境 ----------------
NODE_ENV=development
# API 监听端口(NestJS)
API_PORT=3000
# 允许携带凭证的前端来源(多个用逗号分隔)
WEB_ORIGIN=http://localhost:5173

# ---------------- PostgreSQL ----------------
# 供 docker-compose 的 postgres 容器初始化使用
POSTGRES_USER=knowledgecool
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=knowledgecool
# ⚠️ 这里**没有**「PostgreSQL 端口」这个开关 —— postgres **不对宿主机暴露端口**,
#    只在内网供 api 容器连接(`DATABASE_URL` 里的主机名就是服务名 `postgres`)。
#    曾经留过一个 `POSTGRES_PORT`,但没有任何一处读它:填了不生效的开关
#    比没有开关更坏 —— 有人会改了它然后等一个永远不来的效果。
#    要连进去看数据:`docker compose exec postgres psql -U $POSTGRES_USER -d $POSTGRES_DB`。

# 应用连接串。容器内主机名是服务名 postgres;本机直连用 localhost。
DATABASE_URL=postgresql://knowledgecool:change-me-in-production@localhost:5432/knowledgecool?schema=public
# 仅 `prisma migrate dev` 需要(它要建影子库比对迁移)。生产不填。
SHADOW_DATABASE_URL=

# ---------------- Redis ----------------
REDIS_URL=redis://localhost:6379

# ---------------- 部署(仅 docker-compose 用) ----------------
# web 容器映射到宿主机的端口。默认 8080(开发机上避免占用 80)。
# ⚠️ 它必须与**云安全组实际放行的端口**一致 —— 否则容器活着、公网却打不开。
#    本项目的构建服务器安全组只放行 22 与 80,那里填 80。
#    这一条详见 DESIGN.md §9.7「首次部署」。
WEB_PORT=8080

# ---------------- 会话与上传 ----------------
# 必填且必须改:阶段二协同网关签短期 JWT 用的密钥。生成示例:openssl rand -hex 32
# (阶段一的会话是不透明 token,强度来自随机性,不依赖这个密钥;见 DESIGN §6.1.1)
SESSION_SECRET=
# 会话有效期(小时),默认 720 = 30 天
SESSION_TTL_HOURS=720
# 会话 Cookie 是否带 Secure。默认跟随 NODE_ENV=production 打开。
# TLS 落地(M6)之前若走 http 访问(如本机 compose 验收),必须设为 false。
SESSION_COOKIE_SECURE=true
# 附件落盘目录(本地卷,预留 MinIO 接口)
UPLOAD_DIR=./data/uploads

# ---------------- 登录限流与锁定(v2.12) ----------------
# 同一工号连续失败多少次后锁定账号。默认 5。
# 设为 0(或负数)= 关闭锁定。**不建议关** —— 初始密码是统一的内置值、
# 工号可枚举,没有这条的话暴力破解是不限次数的(见 apps/api/src/auth/login-throttle.ts)。
LOGIN_MAX_ATTEMPTS=5
# 锁定时长(分钟)。默认 15,**到期自动解锁**,不需要管理员介入。
LOGIN_LOCK_MINUTES=15
# 同一来源 IP 在窗口内允许的**失败**次数上限,默认 100。
# ⚠️ 内网常常所有人共用一个出口 IP,所以这里只数失败、不数成功,而且阈值给得宽 ——
#    否则早上集体登录会把整个办公室挡在门外。设 0 关闭。
LOGIN_IP_MAX_FAILURES=100
# IP 限速窗口(分钟)。默认 15。
LOGIN_IP_WINDOW_MINUTES=15

# ---------------- 上传限流(v4.37) ----------------
# 窗口内允许上传的次数,默认 30;窗口默认 5 分钟。设 0 关闭。
# ⚠️ 为什么需要它:单个文件上限(10MB)拦不住**次数**。实测没有它的时候,
#    连传 40 次 / 226ms **全部成功** —— 一个已登录账号一分钟能写进几 GB,
#    而且上传不进审计表,事后连「谁传的」都查不到。
#    见 apps/api/src/upload/upload-throttle.ts。
UPLOAD_MAX_PER_WINDOW=30
UPLOAD_WINDOW_MINUTES=5
# ⚠️ 关闭限流的方式与登录限流一致:把上面两项设成 0,**没有**单独的环境变量开关。

# ⚠️ v2.12 起**没有回收站**了(也没有 TRASH_RETENTION_DAYS /
#    TRASH_PURGE_INTERVAL_HOURS 这两个开关)。删除即物理删除,不可恢复。
#    这是用户明确要求的:不该有回收站这个概念。见 DESIGN §8.2。
#
# 附件单文件上限与白名单**不在这里配**:它们是代码里的常量
# (见 apps/api/src/upload/upload.controller.ts),因为放宽白名单
# 属于安全决策,不应该靠改一个环境变量就能做到。

# ---------------- 前端(Vite) ----------------
# ⚠️ 这里**没有**「API 地址」这个开关 —— 前端把 `/api/v1` 写死在
#    apps/web/src/lib/api.ts 里,因为生产上它总是**同源**的
#    (web 容器里的 nginx 把 /api 反代到 api 容器),开发期由 Vite 代理兜住。
#    曾经留过一个 `VITE_API_BASE`,同样没有任何一处读它。

# ---------------- 其它 ----------------
# 版本号。会出现在 /api/v1/health 的响应里,方便运维确认"跑的是哪一版镜像"。
# 不填则默认 0.1.0(见 apps/api/src/config/configuration.ts)。
APP_VERSION=

