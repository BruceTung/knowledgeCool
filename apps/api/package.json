{
  "name": "@knowledgecool/api",
  "version": "0.1.0",
  "private": true,
  "description": "知源后端:NestJS + Prisma",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "db:verify": "node scripts/verify-db.mjs",
    "dev": "nest start --watch",
    "seed:dev": "node scripts/seed-dev.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:org": "node scripts/verify-org.mjs",
    "verify:doc": "node scripts/verify-doc-claims.mjs"
  },
  "dependencies": {
    "@knowledgecool/shared": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@node-rs/bcrypt": "^1.10.9",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.3",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
