// 知源 KnowledgeCool · 数据模型
// 逐字对应 DESIGN.md §4.2 的建表 DDL。
//
// ⚠️ v2.0(2026-09-26)模型重做 —— 空间与页面**合并为一棵 `nodes` 树**:
//   - 作废:`spaces` / `space_members` / `page_permissions`
//   - 改名:`pages` → `nodes`(加 `kind` / `owner_id`),`page_contents` → `node_contents`
//   - 新增:`org_assignments`(组织归属)、`node_grants`(授权名单)
//   理由见 DESIGN.md §1.1 与 §4.1;权限判定见 §5.2。
//
// ⚠️ v2.2(2026-09-26)—— 登录标识由邮箱改为**工号**:
//   - `users.email`(citext) → `users.employee_no`(text)
//   - 新增 `users.must_change_password`(新账号一律 true,首登强制改密,见 §6.1.2)
//   - `citext` 扩展不再需要
//
// Prisma 7 的三处重要变化(首次开工时实测确认):
//   1. 生成器是 `prisma-client`(不是 prisma-client-js),`output` 为必填,
//      且产出的是 **TypeScript 源码**(带 @ts-nocheck),由本项目的 tsc 一起编译。
//   2. datasource 不再写 `url` —— 连接串移到 prisma7.config.ts。
//   3. 连接数据库**必须**经由 driver adapter(@prisma/adapter-pg),见 prisma.service.ts。
//
// Prisma schema 表达不了的东西,在 migration 的 SQL 里手写补齐:
//   - CHECK 约束(状态枚举用 text + check,刻意不用 PG enum:enum 增删值很痛)
//   - pg_trgm 的 GIN 索引(node_contents_trgm_idx,已用 type/ops 表达进 schema)
//   - audit_logs.ip 的类型(Prisma 不支持 inet 标量,用 text)

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat        = "esm"
  // ESM 下相对导入必须有显式扩展名。Prisma 默认产出 './enums'(无扩展名),
  // 经 tsc 编译后 Node ESM 会直接 ERR_MODULE_NOT_FOUND —— 必须打开这个选项。
  importFileExtension = "js"
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ---------------- 用户 ----------------
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 工号(v2.2)。**登录标识就是它**,不是邮箱。
  /// 用 text 而非数字:工号常带字母前缀或前导零(如 KC2026001),当数字存会丢信息。
  employeeNo   String    @unique @map("employee_no")
  name         String
  passwordHash String    @map("password_hash")
  /// 首次登录必须改密(v2.2)。新账号统一初始密码 123456(内置,不进模板),
  /// 所以必须有这个开关 —— 且它是**服务端拦截**的依据,不是纯前端状态(§6.1.2)。
  mustChangePassword Boolean @default(true) @map("must_change_password")
  avatarColor  String    @default("gray") @map("avatar_color")
  /// active 在职 | disabled 账号被停用 | departed 已离职 —— check 约束在 migration 里
  status       String    @default("active")
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// 我拥有所有权的节点(部门 / 组 / 页面)
  ownedNodes     Node[]          @relation("NodeOwner")
  createdNodes   Node[]          @relation("NodeCreatedBy")
  updatedNodes   Node[]          @relation("NodeUpdatedBy")
  /// 组织归属(多归属)
  assignments    OrgAssignment[]
  /// 我授予别人的编辑权
  grantedGrants  NodeGrant[]     @relation("GrantGrantedBy")
  /// 别人授予我的编辑权
  receivedGrants NodeGrant[]     @relation("GrantUser")
  /// 别人把我加进哪些受限节点的读者名单
  readableNodes  NodeReader[]    @relation("NodeReaderUser")
  /// 我授出去的读者名单条目
  grantedReads   NodeReader[]    @relation("NodeReaderGrantedBy")
  comments       Comment[]
  auditLogs      AuditLog[]
  sessions       Session[]

  @@map("users")
}

// ---------------- 会话(见 DESIGN.md §6.1.1) ----------------
model Session {
  /// 主键是 token 的 SHA-256(64 位十六进制),**不存 token 本身** ——
  /// 这样即使数据库被读走,也无法据此伪造登录态。
  id         String   @id @db.Char(64)
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  userAgent  String?  @map("user_agent")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 按用户批量吊销(停用账号)与清理过期行都要用到。
  // 显式命名而非依赖 Prisma 自动推导,避免手写 migration SQL 时名字对不上。
  @@index([userId], map: "sessions_user_idx")
  @@index([expiresAt], map: "sessions_expires_idx")
  @@map("sessions")
}

// ---------------- 节点树(空间与页面合并,v2.0 核心表) ----------------
model Node {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// onDelete: Restrict —— 数据库不允许"父行还在、子行被删"。
  ///
  /// ⚠️ v2.12 起**没有软删除**了(回收站已整体移除),所以这条约束的作用
  /// 变成了另一件事:它逼着**应用层按「深度从叶子往根」逐层删**
  /// (见 `NodeService.deleteSubtree`)。这也正是 v2.12 的迁移脚本要绕那么大
  /// 一圈的原因 —— DELETE 不支持 ORDER BY,一条语句删整棵子树会撞外键。
  /// 原文写"强制走软删除流程",那句在回收站移除之后已经不成立。
  parentId String? @map("parent_id") @db.Uuid

  /// space | document —— **纯展示用途,权限判定不区分 kind**。
  /// 一个 space 节点可以有正文,一个 document 节点可以有子节点,这是刻意的(§4.1 第 2 条)。
  /// 不要在权限代码里对 kind 做分支。
  kind     String @default("document")
  title    String @default("未命名")
  /// 同级排序
  position Int    @default(0)
  /// '/<祖先id>/.../<自身id>' —— 移动节点时必须递归重建整棵子树。
  /// 权限判定完全依赖它(要拿整条祖先链上的 owner),失败是**静默越权或静默失权**。
  materializedPath String @default("") @map("materialized_path")
  depth            Int    @default(0)

  /// 所有者。部门 = 部长(组织架构预置);二级节点 = 部长任命;更深节点 = 创建者。
  /// not null:没有"无主节点"这种状态。
  ownerId String @map("owner_id") @db.Uuid

  /// draft | published | archived —— check 约束在 migration 里
  status  String @default("published")
  /// public | restricted —— check 约束在 migration 里(v2.12 新增)。
  ///
  /// restricted = 只有「所有者链 + 读者名单」能读;**整棵子树继承**(后代无法放开)。
  /// 继承方向是刻意选的:允许放开某个子节点,会让「这棵树到底谁能看」
  /// 变成需要逐节点推理的事,而漏判一次就是一次信息泄露。
  visibility String @default("public")
  /// 乐观锁。**哪些操作校验它、哪些不校验,如实写在这里**(别以为写了这行就都受保护):
  ///   - **校验并递增**:改名(`NodeService.update`)、单节点移动(`move`)、
  ///     替换授权名单(`replaceGrants`)、替换读者名单(`replaceReaders`) ——
  ///     都是"带 version 条件 + 检查影响行数"的比较并交换(CAS),抢不到就 409
  ///   - **不校验、但递增**:变更所有者(`setOwner` / 导入里的换所有者)——
  ///     `SetOwnerDto` 里**没有** version 字段(所以无法校验、抢不到也不会 409);
  ///     但写入时**会**把 `version` 加一(`org.service.ts` 的 `setOwner`、
  ///     `import.service.ts` 的换所有者那一批)。
  ///
  ///     ⚠️ v4.23 更正:原文把 `setOwner` 归在"**不校验、也不递增**"里 ——
  ///     **后半句是错的**。实测两处写入都带 `version: { increment: 1 }`。
  ///     这个区别有实际意义:"递增"意味着前端手里的旧 version **会**在下次
  ///     改名/移动时撞出 409(而不是像批量移动那样静默通过)—— 是更安全的一侧。
  ///   - **校验但不递增**:无
  ///   - **不校验、也不递增**:删除(`remove`)、**批量移动(`bulkMove`)**
  ///     —— 这两条的 DTO 里没有 version 字段,且写入时也不递增。
  ///     `BulkMoveDto` 确实没有 version,而 `applyMoveTo` 在 version 省略时
  ///     只更新 `updatedBy`。
  ///
  ///     实际后果:批量移动之后,前端手里的 version 仍是旧的 ——
  ///     乐观锁察觉不到这次改动。这是**已知的欠账**,不是漏洞
  ///     (并发下不会损坏数据,但"后写覆盖前写"是可能的)。
  version Int    @default(1)

  createdBy String  @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent      Node?            @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children    Node[]           @relation("NodeChildren")
  owner       User             @relation("NodeOwner", fields: [ownerId], references: [id])
  creator     User             @relation("NodeCreatedBy", fields: [createdBy], references: [id])
  updater     User?            @relation("NodeUpdatedBy", fields: [updatedBy], references: [id])
  content     NodeContent?
  grants      NodeGrant[]
  readers     NodeReader[]
  assignments OrgAssignment[]
  comments    Comment[]

  @@index([parentId, position], map: "nodes_tree_idx")
  // 物化路径的前缀查询('/p1/p2%')必须带 text_pattern_ops 才吃得到索引。
  // 用 ops: raw(...) 把它表达进 schema —— 否则 Prisma 会认为这个索引"多余",
  // 下次 migrate dev 生成 DROP INDEX,静默废掉前缀查询(而权限判定正靠它)。
  @@index([materializedPath(ops: raw("text_pattern_ops"))], map: "nodes_path_idx")
  @@index([ownerId], map: "nodes_owner_idx")
  // ⚠️ 检索的 WHERE 是 `n.title ILIKE … OR c.text_for_search ILIKE …`。
  // 只要 OR 里**有一支**走不了索引,整个条件就退化成顺序扫描 ——
  // 而 `node_contents` 那个 trgm 索引单独立不住这个查询(实测见 migration
  // 20260928_audit_nodes_indexes 的注释)。所以 `nodes.title` 必须也有一条。
  // 用 gin_trgm_ops:它服务的是 `ILIKE '%子串%'`,不是等值查询。
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "nodes_title_trgm_idx")
  // ⚠️ v2.12 起**没有** nodes_alive_idx(部分索引)了 —— 它是为软删除服务的,
  // 而回收站已被整体移除(删除即物理删除)。见 migration 20260927120000_drop_trash。
  @@map("nodes")
}

// ---------------- 受限节点的读者名单(v2.12 新增) ----------------
/// 「谁能读」的独立授权表 —— **刻意不复用 node_grants**。
///
/// 两张表管的是两件事:
///   · node_grants  = **能改**(编辑权,可以是别人给的)
///   · node_readers = **能读**(只在 visibility = restricted 的节点上有意义)
///
/// 为什么不合并成一张表加一个 level 列:合并之后,「把某人加进编辑名单」
/// 与「让某人看得见」会共用一条路径,而**误加一次就是一次泄露**;
/// 分开之后,两条路径各自的接口、门槛与审计动作都能单独收紧。
/// 用户的原话也是「创建者单独授权,不复用」。
model NodeReader {
  nodeId    String   @map("node_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// 谁授的权。留痕用 —— 出问题时能回答「这个人是被谁放进来的」。
  grantedBy String   @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  node    Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user    User @relation("NodeReaderUser", fields: [userId], references: [id], onDelete: Cascade)
  granter User @relation("NodeReaderGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict)

  @@id([nodeId, userId])
  /// 反查「我能读哪些受限节点」要用这个索引 —— **但今天还没有这样的查询**:
  /// 三处判定都按 `nodeId` 过滤(`permission.service.ts` 的 `listsOfNodeIds` /
  /// `buildReadersView`),走的是上面那个复合主键。
  /// 留着是因为 `User.readableNodes` 这条关系一旦被 `include`,没有它就退化成顺序扫描;
  /// 若确认永远不会有反查,删掉它可以省下一次写入维护。
  @@index([userId], map: "node_readers_user_idx")
  @@map("node_readers")
}

// ---------------- 组织归属(多归属,v2.0 新增) ----------------
/// 一个人可以同属多个部门 / 组 / 项目。它承担两个职责:
///   ① 展示"这个人在组织里的位置";② 界定**授权范围**(§5.3 规则三)。
model OrgAssignment {
  userId    String   @map("user_id") @db.Uuid
  nodeId    String   @map("node_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@index([nodeId], map: "org_assignments_node_idx")
  @@map("org_assignments")
}

// ---------------- 显式授权名单(v2.0 新增) ----------------
/// 对应「组长想再加一个人改」。**只有加法,没有 deny** ——
/// 收回权限 = 删掉这里的行。不要为了"对称"补一个 deny 列(§4.3)。
model NodeGrant {
  nodeId    String   @map("node_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  grantedBy String   @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  node    Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user    User @relation("GrantUser", fields: [userId], references: [id], onDelete: Cascade)
  granter User @relation("GrantGrantedBy", fields: [grantedBy], references: [id])

  @@id([nodeId, userId])
  @@map("node_grants")
}

// ---------------- 正文 ----------------
model NodeContent {
  nodeId String @id @map("node_id") @db.Uuid
  /// ProseMirror 文档树。**绝不允许存 Markdown 字符串**(DESIGN.md §10 硬约束 2)
  contentJson Json @default("{\"type\": \"doc\", \"content\": []}") @map("content_json")
  /// 阶段二启用,阶段一保持 null —— 字段先建好,这就是「按协同的地基写代码」
  ydocSnapshot Bytes? @map("ydoc_snapshot")
  /// 由 content_json 抽出的纯文本,供 pg_trgm 检索(JSONB 没法直接模糊匹配)
  textForSearch String @default("") @map("text_for_search")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  // 中文子串检索的 GIN 三元组索引(DESIGN.md §2.3)。用 type: Gin + ops: raw 表达,
  // 让 Prisma 认得它 —— 否则 migrate dev 会生成 DROP INDEX,静默废掉中文检索。
  @@index([textForSearch(ops: raw("gin_trgm_ops"))], type: Gin, map: "node_contents_trgm_idx")
  @@map("node_contents")
}

// ---------------- 评论(全员可发,v2.0) ----------------
/// ⚠️ **评论就是评论,不是"问题单"(v2.4)。**
///
/// 这里曾有一个 `status` 列(`open` / `resolved`),界面上表现为「标记已解决」
/// 与节点树上的「未解决评论」角标。用户明确纠正过:「评论只是评论,不是问题,
/// 你不要擅自赋予评论额外的含义」—— 那套语义已连同这一列一起删除。
///
/// 不要再把状态字段加回来。一个没人要求的状态机,会让每条评论都背上
/// "它解决了没有"这个问题,而讨论本来不需要被结案。
model Comment {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId    String  @map("node_id") @db.Uuid
  /// 一层回复
  parentId  String? @map("parent_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  // 阶段二会新增 anchor_type / anchor_text / anchor_pos 三列 —— 现在刻意不加

  node    Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
  user    User      @relation(fields: [userId], references: [id])

  @@index([nodeId, createdAt], map: "comments_node_idx")
  @@map("comments")
}

// ---------------- 审计日志 ----------------
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  /// 取值见 `packages/shared/src/audit.ts` 的 AUDIT_ACTIONS —— 那是唯一清单:
  /// node.create / node.move / node.delete / grant.replace / visibility.replace /
  /// org.import / comment.create / auth.login ...
  /// (原文举例里的 `grant.add` 是 v2.0 之前的动作名,现在叫 grant.replace。)
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  detail     Json     @default("{}")
  /// 原写 inet;Prisma 不支持该标量,改用 text(DESIGN v1.2 已同步)
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt(sort: Desc)], map: "audit_created_idx")
  // ⚠️ 下面两条是给 `queryRows` 那个 WHERE 的 OR 用的
  // (`actor_id = ? OR target_id = ANY(?) OR detail->>'nodeId' = ANY(?)`)。
  // 原来只有 created_at 一条 —— 而那个查询**按 id 排序、三个条件字段都没索引**,
  // 数据量一上来就是全表扫。见 migration 20260928_audit_nodes_indexes。
  @@index([actorId], map: "audit_actor_idx")
  @@index([targetId], map: "audit_target_idx")
  @@map("audit_logs")
}
